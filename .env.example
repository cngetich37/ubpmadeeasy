# Template for local development. Copy to .env (gitignored) and fill in real values.
# Real values live in Vercel (Project Settings -> Environment Variables). With the
# Vercel CLI you can pull them straight into .env:  npx vercel env pull .env
# Every UBP_* value is inlined into the public JS bundle, so never put secrets here.
UBP_API_URL=https://your-backend.example.com
UBP_SITE_URL=http://localhost:5173
UBP_NAIROBI_PAY_URL=https://nairobi-pay.example.com/
UBP_FINANCE_ACT_URL=https://finance-act.example.com/download/finance-act/
