# Public, non-secret build-time config. Vite exposes only VITE_* vars to the app,
# and they end up in the built JS, so never put secrets here.
# To override locally (e.g. a local backend), create .env.local (gitignored).
VITE_API_URL=https://effortlessubp-backend.onrender.com
VITE_SITE_URL=https://ubpeasy.vercel.app
VITE_NAIROBI_PAY_URL=https://nairobiservices.go.ke/
VITE_FINANCE_ACT_URL=https://nairobi.go.ke/download/the-nairobi-city-county-finance-act2023/
